import time
import requests
from bs4 import BeautifulSoup
import pandas as pd
import mysql.connector

# 1. Rate-Limiting & Exception Handling Protocol
def fetch_page_source(url):
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
    }
    try:
        # Implementing 1-second delay to eliminate IP blocking risks entirely
        time.sleep(1) 
        response = requests.get(url, headers=headers, timeout=10)
        
        if response.status_code == 200:
            return response.text
        else:
            print(f"[Warning] Failed to fetch data. Status Code: {response.status_code}")
            return None
    except requests.exceptions.RequestException as e:
        print(f"[Error] Network or Connection Alert: {e}")
        return None

# 2. Data Cleaning Pipeline using Pandas (Targeting 98% Accuracy)
def clean_and_structure_data(raw_data_list):
    # Converting extracted dynamic items into a DataFrame
    df = pd.DataFrame(raw_data_list)
    
    # Handling missing values and ensuring clean data items
    df['price'] = df['price'].fillna(0.0)
    df['reviews'] = df['reviews'].fillna("No reviews yet")
    df.dropna(subset=['product_name'], inplace=True)
    
    return df.to_dict(orient='records')

# 3. Exporting Structured Records into MySQL Database
def export_to_mysql(structured_records):
    try:
        # Establish connection with local/cloud MySQL
        db_connection = mysql.connector.connect(
            host="localhost",
            user="root",
            password="secure_password",
            database="research_initiative_db"
        )
        cursor = db_connection.cursor()
        
        query = "INSERT INTO products (name, price, review) VALUES (%s, %s, %s)"
        
        for item in structured_records:
            cursor.execute(query, (item['product_name'], item['price'], item['reviews']))
            
        db_connection.commit()
        print(f"[Success] Successfully exported {len(structured_records)} items into MySQL.")
        
    except mysql.connector.Error as err:
        print(f"[Database Error] Integration Failed: {err}")
    finally:
        if 'db_connection' in locals() and db_connection.is_connected():
            cursor.close()
            db_connection.close()

